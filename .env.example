# ── These go into Railway → Variables (or a local .env for testing) ───────────

# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs of the two allowed users
# Leave empty to run in bootstrap mode (bot shows any user their ID)
ALLOWED_USER_IDS=123456789,987654321

# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Kolkata

# Morning digest time (24-hour clock, local time)
MORNING_DIGEST_HOUR=8
MORNING_DIGEST_MINUTE=0

# SQLite database path (Railway persists this via a volume)
DATABASE_PATH=data/reminders.db

# ── OpenRouter (optional — enables smarter natural language parsing) ───────────
# Sign up free at openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=your_openrouter_key_here
# Free model — see openrouter.ai/models?q=free for options
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
